# Adresse der Website (für Canonical-Links, Sitemap und Vorschaubilder)
NEXT_PUBLIC_SITE_URL=https://gluecksbringer-am-meer.de

# Optional: Kontaktformular. Nur wenn beide Werte gesetzt sind, wird das
# Formular auf der Kontaktseite angezeigt. Ohne sie steht dort die
# E-Mail-Adresse des Vereins.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# KONTAKT_ABSENDER=website@gluecksbringer-am-meer.de
# KONTAKT_EMPFAENGER=info@gluecksbringer-am-meer.de
