  headImage={headImage}
  headImageAlt="Materialaufnahme: aufgerissene Kante einer entkernten Innenwand, Putz- und Estrichschichten im Schnitt."
  bandImage={bandImage}
  bandAlt="Materialaufnahme: sortierter Bauschutt aus Beton, Ziegel und Stahl, scharfe Bruchflächen im Schatten."
