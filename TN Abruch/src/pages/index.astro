<script>
  // Hero: sehr langsamer Scale. Nur solange der Hero sichtbar ist.
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const hero = media?.parentElement;
  if (media && hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      const p = Math.min(Math.max(-hero.getBoundingClientRect().top / hero.offsetHeight, 0), 1);
      hero.style.setProperty('--hero-scale', String(1 + p * 0.06));
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) addEventListener('scroll', onScroll, { passive: true });
      else removeEventListener('scroll', onScroll);
    });
    io.observe(hero);
    update();
  }
</script>
