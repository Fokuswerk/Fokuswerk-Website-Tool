---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import SectionMarker from '~/components/SectionMarker.astro';
import Cta from '~/components/Cta.astro';
import Rueckbau from '~/components/Rueckbau.astro';
import { company, credentials, fleet, yearsActive } from '~/data/company';

import heroImg from '~/assets/schadstoffsanierung-breit.jpg';
import ppeImg from '~/assets/schadstoffsanierung-hoch.jpg';
import materialImg from '~/assets/material-beton-bewehrung.jpg';
import yardImg from '~/assets/fuhrpark-16x9.jpg';
import svcSanierung from '~/assets/schadstoffsanierung-hoch.jpg';
import svcRueckbau from '~/assets/fuhrpark-maschinen.jpg';
import svcBeton from '~/assets/material-beton-hoch.jpg';
import svcContainer from '~/assets/fuhrpark-panorama.jpg';
import pqLogo from '~/assets/logo-pq-vob.png';
import avnLogo from '~/assets/logo-avn.png';
import navLogo from '~/assets/logo-nav.png';

const refs = (await getCollection('referenzen')).map((r) => r.data).sort((a, b) => b.year - a.year);
const jobs = (await getCollection('jobs')).sort((a, b) => a.data.order - b.data.order);
const highlights = [
  'hochschule-fuer-technik-2001',
  'ekz-raunheim-2009',
  'rathaus-dietzenbach-2010',
  'eads-airbus-bremen-2007',
  'haus-der-buergerschaft-2009',
  'gewoba-2019',
].map((s) => refs.find((r) => r.slug === s)!);

const largest = Math.max(...refs.filter((r) => r.unit === 'cbm').map((r) => r.quantity ?? 0));

const services = [
  {
    no: '01',
    href: '/leistungen/schadstoffsanierung/',
    title: 'Schadstoffsanierung',
    img: svcSanierung,
    alt: 'Zwei Mitarbeiter in Vollschutz verpacken ausgebaute Mineralwolle vor einem Container.',
    kicker: 'Asbest & Mineralwolle',
    body: 'Asbest und alte Mineralwolle holen wir heraus — abgeschottet, unter Unterdruck, mit Entsorgungsnachweis. Für beides sind wir zugelassen.',
    figure: '12.500',
    figureUnit: 'cbm Raum unter Unterdruck',
  },
  {
    no: '02',
    href: '/leistungen/rueckbau-entkernung/',
    title: 'Rückbau & Entkernung',
    img: svcRueckbau,
    alt: 'Bagger und Radlader auf dem Betriebshof in Delmenhorst.',
    kicker: 'Hand bis Industriegröße',
    body: 'Wir räumen ein Gebäude bis auf das Tragwerk leer und reißen ab, was weg soll — vom einzelnen Balkon bis zum ganzen Innenleben.',
    figure: '18,5',
    figureUnit: 't größter Bagger',
  },
  {
    no: '03',
    href: '/leistungen/beton-bohren-saegen/',
    title: 'Beton, Bohren & Sägen',
    img: svcBeton,
    alt: 'Bruchkante aus Beton mit freiliegender Bewehrung.',
    kicker: 'Bohren & Sägen',
    body: 'Öffnungen in Beton — gebohrt und gesägt statt gestemmt. Ohne Risse in der Nachbarwand, auch im bewohnten Haus.',
    figure: '1997',
    figureUnit: 'seit dem Gründungsjahr',
  },
  {
    no: '04',
    href: '/leistungen/entsorgung-container/',
    title: 'Entsorgung & Container',
    img: svcContainer,
    alt: 'Containerfahrzeuge und Behälter auf dem Betriebshof.',
    kicker: '2 bis 36 cbm',
    body: 'Container von der kleinen Mulde bis 36 Kubikmeter, eigene Fahrzeuge. Wir trennen das Material und entsorgen es mit Nachweis.',
    figure: '2–36',
    figureUnit: 'cbm Behältergrößen',
  },
];
---

<Base
  title="TN Abbruch — Rückbau und Schadstoffsanierung, Delmenhorst"
  description="Entkernung, Rückbau und Asbestsanierung seit 1997. Zugelassen nach TRGS 519 Ziffer 2.7 Anlage 3 — einschließlich weichgebundener Produkte. Delmenhorst bei Bremen."
>
  <!-- ══ HERO ═══════════════════════════════════════════════════════════ -->
  <section class="hero zone-dark">
    <div class="hero__media" data-hero-media>
      <Image
        src={heroImg}
        alt="Zwei Sanierungskräfte in Vollschutz mit Atemschutz verpacken ausgebaute Mineralwolle in einen zugelassenen Sack."
        widths={[760, 1200, 1477]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="avif"
        quality={72}
      />
    </div>

    <div class="hero__body wrap">
      <p class="hero__kicker label">
        Delmenhorst bei Bremen<span aria-hidden="true"> · </span>seit {company.foundedYear}<span aria-hidden="true"> · </span>bundesweit
      </p>

      <h1 class="hero__head"><span>Wenn Asbest auftaucht,</span> <span>fangen wir an.</span></h1>

      <p class="hero__lead">
        Wir räumen Gebäude leer, holen Asbest und alte Mineralwolle heraus und reißen ab,
        was weg soll. Dafür braucht es eine amtliche Zulassung —
        <strong>wir haben die anspruchsvollste Stufe</strong>, die das deutsche
        Asbestrecht kennt.
      </p>

      <div class="hero__actions">
        <a href="/kontakt/" class="btn btn--primary">
          Projekt anfragen
          <svg class="btn__arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
        <a href="/leistungen/schadstoffsanierung/" class="btn btn--ghost">Schadstoffsanierung</a>
      </div>
    </div>

    <div class="hero__data">
      <div class="wrap hero__data-grid">
        <div class="hero__stat">
          <span class="hero__stat-v num"><span data-count={yearsActive}>{yearsActive}</span></span>
          <span class="hero__stat-l">Jahre im Rückbau</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-v num"><span data-count={refs.length}>{refs.length}</span></span>
          <span class="hero__stat-l">dokumentierte Projekte</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-v num"><span data-count={largest}>{largest.toLocaleString('de-DE')}</span></span>
          <span class="hero__stat-l">cbm größte Entkernung</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-v num">2013</span>
          <span class="hero__stat-l">präqualifiziert seit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 01 NACHWEISE ═══════════════════════════════════════════════════ -->
  <Rueckbau />

  <section class="section ruled" id="nachweise">
    <div class="wrap">
      <SectionMarker no="01" label="Nachweise" rest="Zulassung · Präqualifikation · Verbände" />

      <div class="proof__head">
        <h2>Woran Sie erkennen,<br />dass wir das dürfen.</h2>
        <p class="lead muted">
          Im Rückbau wird nicht nach Sympathie vergeben, sondern nach Nachweisen. Diese
          hier sind prüfbar — Nummer für Nummer.
        </p>
      </div>

      <ol class="proof" role="list" data-rise-group>
        {credentials.map((c, i) => (
          <li class="proof__item" data-rise>
            <span class="proof__no num">{String(i + 1).padStart(2, '0')}</span>
            <div class="proof__main">
              <h3>{c.title}</h3>
              <p class="proof__body">{c.body}</p>
            </div>
            <span class="proof__tag num">{c.proof}</span>
          </li>
        ))}
      </ol>

      <div class="proof__marks">
        <Image src={pqLogo} alt="Siegel Präqualifikation Bau nach VOB, Registernummer 010.053470" widths={[200, 400]} sizes="90px" />
        <Image src={avnLogo} alt="Logo Abbruchverband Nord e.V." widths={[240, 480]} sizes="150px" />
        <Image src={navLogo} alt="Logo Norddeutscher Asbest- und Gefahrstoffsanierungsverband Nord e.V." widths={[200, 400]} sizes="110px" />
        <p class="proof__marks-note">
          Verbandsmitgliedschaften und Präqualifikation. Die PQ-Nummer ist über die
          Präqualifikationsliste des Vereins für die Präqualifikation von Bauunternehmen
          nachprüfbar.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ 02 LEISTUNGEN ══════════════════════════════════════════════════ -->
  <section class="section ruled" id="leistungen">
    <div class="wrap">
      <SectionMarker no="02" label="Leistungen" rest="Vier Gewerke, ein Betriebshof" />

      <div class="svc__head">
        <h2>Was wir machen —<br />und was nicht.</h2>
        <p class="lead muted">
          Kein Neubau, kein Tiefbau, kein Erdbau. Wir sind auf den Weg zurück
          spezialisiert: Gebäude leerräumen, Schadstoffe herausholen, Material trennen.
        </p>
      </div>

      <ul class="svc" role="list" data-rise-group>
        {services.map((s) => (
          <li class="svc__item" data-rise>
            <a href={s.href} class="svc__link">
              <span class="svc__media">
                <Image src={s.img} alt="" widths={[420, 640, 860]} sizes="(min-width: 64rem) 42vw, 100vw" loading="lazy" />
              </span>

              <span class="svc__text">
                <span class="svc__top">
                  <span class="svc__no num">{s.no}</span>
                  <span class="svc__kicker label">{s.kicker}</span>
                </span>

                <span class="svc__name">{s.title}</span>
                <span class="svc__body">{s.body}</span>

                <span class="svc__foot">
                  <span class="svc__fig">
                    <span class="svc__fig-v num">{s.figure}</span>
                    <span class="svc__fig-l">{s.figureUnit}</span>
                  </span>
                  <span class="svc__go">
                    Ansehen
                    <svg class="svc__arrow" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 2.5 12.5 7 8 11.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ 03 DER FUND ════════════════════════════════════════════════════ -->
  <section class="section find zone-dark" id="fund">
    <div class="find__bg" aria-hidden="true">
      <Image src={materialImg} alt="" widths={[900, 1400, 2000]} sizes="100vw" format="avif" quality={55} loading="lazy" />
    </div>

    <div class="wrap find__inner">
      <SectionMarker no="03" label="Ernstfall" rest="Gefahrstoffverordnung" />

      <div class="find__grid">
        <div class="find__text">
          <h2>Wenn der Fund kommt.</h2>
          <p class="lead">
            Der Rückbau läuft, die Wand ist offen — und darunter liegt etwas, das im
            Gutachten nicht stand. Ab diesem Moment ist die Baustelle keine Baustelle
            mehr, sondern ein Gefahrstoffbereich.
          </p>
          <p class="find__note">
            Die novellierte Gefahrstoffverordnung hat die Anforderungen an solche
            Situationen verschärft. Für Bauherren heißt das vor allem eines: Der Fehler
            danach ist teurer als die Erkundung davor. Wir sind der Betrieb, der auch die
            Fälle übernimmt, bei denen andere abgeben müssen.
          </p>
          <a href="/leistungen/schadstoffsanierung/" class="btn btn--ghost">
            Ablauf der Sanierung
            <svg class="btn__arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </a>
        </div>

        <ol class="steps" role="list" data-rise-group>
          <li class="steps__item" data-rise>
            <span class="steps__no num">A</span>
            <h3>Arbeiten einstellen</h3>
            <p>Bereich sichern, niemand arbeitet weiter. Bei Verdacht gilt der Stoff als Gefahrstoff, bis das Gegenteil belegt ist.</p>
          </li>
          <li class="steps__item" data-rise>
            <span class="steps__no num">B</span>
            <h3>Feststellen, was da liegt</h3>
            <p>Probenahme und Analyse durch ein akkreditiertes Labor. Erst das Ergebnis entscheidet über Verfahren und Schutzstufe.</p>
          </li>
          <li class="steps__item" data-rise>
            <span class="steps__no num">C</span>
            <h3>Schwarzbereich einrichten</h3>
            <p>Abschottung, Unterdruckhaltung, Personen- und Materialschleuse. Bei uns 1- bis 4-Kammerschleusen, UHG-Geräte von {fleet.uhg}.</p>
          </li>
          <li class="steps__item" data-rise>
            <span class="steps__no num">D</span>
            <h3>Ausbauen, messen, freigeben</h3>
            <p>Ausbau, Verpackung nach TRGS, Entsorgung mit Nachweis. Freimessung, dann Rückgabe des Bereichs — und der Rückbau läuft weiter.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ══ 04 REFERENZEN ══════════════════════════════════════════════════ -->
  <section class="section ruled" id="referenzen">
    <div class="wrap">
      <SectionMarker no="04" label="Auftragsbuch" rest={`${refs[refs.length - 1].year}–${refs[0].year}`} />

      <div class="ref__head">
        <h2>Das Auftragsbuch,<br />nicht die Bildergalerie.</h2>
        <p class="lead muted">
          Auf Rückbaubaustellen wird selten fotografiert — im Schwarzbereich schon gar
          nicht. Was bleibt, sind Auftraggeber, Leistung und Menge. Sechs von {refs.length}.
        </p>
      </div>

      <ol class="ref" role="list" data-rise-group>
        {highlights.map((r) => (
          <li class="ref__item" data-rise>
            <span class="ref__year num">{r.year}</span>
            <span class="ref__client">
              <span class="ref__name">{r.client}</span>
              <span class="ref__sector label">{r.sector}</span>
            </span>
            <span class="ref__scope">{r.scope}</span>
            {r.quantity
              ? <span class="ref__qty"><span class="ref__qty-v num">{r.quantity.toLocaleString('de-DE')}</span><span class="ref__qty-u num">{r.unit}</span></span>
              : <span class="ref__qty ref__qty--none" aria-hidden="true">—</span>}
          </li>
        ))}
      </ol>

      <a href="/referenzen/" class="btn btn--ghost ref__more">
        Alle {refs.length} Projekte
        <svg class="btn__arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
      </a>
    </div>
  </section>

  <!-- ══ 05 BETRIEBSHOF ═════════════════════════════════════════════════ -->
  <section class="section yard zone-dark" id="betriebshof">
    <div class="wrap">
      <SectionMarker no="05" label="Betriebshof" rest="Mackenstedter Str. 21, Delmenhorst" />
      <h2 class="yard__head">Alles steht auf dem eigenen Hof.</h2>
    </div>

    <figure class="yard__fig">
      <Image src={yardImg} alt="Aufgereihter Fuhrpark von TN Abbruch auf dem Betriebshof in Delmenhorst: Kettenbagger, Mobilbagger, Containerfahrzeuge, Transporter und Abrollcontainer nebeneinander." widths={[760, 1200, 1600, 1139]} sizes="100vw" format="avif" quality={72} loading="lazy" />
      <figcaption class="wrap label">Betriebshof Delmenhorst, aufgenommen 2020</figcaption>
    </figure>

    <div class="wrap yard__grid">
      <div class="yard__text">
        <p class="lead">
          Wer Geräte mietet, ist von Verfügbarkeiten abhängig. Bagger, Radlader,
          Containerfahrzeuge, Unterdruckanlagen und Schleusen gehören uns — das ist der
          Grund, warum ein Team von {company.teamSize} Leuten Mengen bewegt, die man hier
          nicht erwartet.
        </p>
        <a href="/unternehmen/" class="btn btn--ghost">
          Über das Unternehmen
          <svg class="btn__arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
      </div>

      <dl class="yard__specs">
        <div><dt>Bagger</dt><dd class="num">{fleet.excavators.join(' · ')}</dd></div>
        <div><dt>Radlader</dt><dd class="num">{fleet.loaders.join(' · ')}</dd></div>
        <div><dt>Containerfahrzeuge</dt><dd class="num">{fleet.containerVehicles}</dd></div>
        <div><dt>Behältergrößen</dt><dd class="num">{fleet.containerRange}</dd></div>
        <div><dt>Schleusen</dt><dd>{fleet.airlocks}</dd></div>
        <div><dt>UHG-Geräte</dt><dd class="num">{fleet.uhg}</dd></div>
      </dl>
    </div>
  </section>

  <!-- ══ 06 SCHADSTOFF-QUERVERWEIS ══════════════════════════════════════ -->
  <section class="section ruled" id="schwarzbereich">
    <div class="wrap black__grid">
      <figure class="black__fig">
        <Image src={ppeImg} alt="Zwei Mitarbeiter von TN Abbruch in weißer Einweg-Schutzkleidung mit Atemschutzmasken verpacken ausgebaute Mineralwolle in einen gekennzeichneten KMF-Sack nach TRGS 521." widths={[500, 800, 996]} sizes="(min-width: 60rem) 40vw, 100vw" format="avif" quality={72} loading="lazy" />
        <figcaption class="label">KMF-Ausbau, Verpackung nach TRGS 521</figcaption>
      </figure>

      <div class="black__text">
        <SectionMarker no="06" label="Schwarzbereich" />
        <h2>Keine Faser zu viel.</h2>
        <p class="lead muted">
          Schadstoffsanierung ist kein Kraftakt, sondern eine Disziplinfrage:
          Abschottung dicht, Unterdruck gehalten, Schleuse in der richtigen Reihenfolge
          durchlaufen, Material korrekt verpackt und deklariert.
        </p>
        <p class="muted">
          Unsere Mitarbeiter im Sanierungsbereich haben den Sachkundenachweis nach
          TRGS 519 und TRGS 521. Die Präqualifikation für Asbestsanierungsarbeiten
          besteht seit {2013}.
        </p>
        <a href="/leistungen/schadstoffsanierung/" class="btn btn--ghost">
          Schadstoffsanierung im Detail
          <svg class="btn__arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Cta
    heading="Erzählen Sie uns, was weg soll."
    body="Ein Anruf reicht für eine erste Einschätzung — auch wenn Sie noch nicht wissen, ob Schadstoffe im Spiel sind. Das finden wir gemeinsam heraus."
  />

  <!-- ══ 07 KARRIERE ════════════════════════════════════════════════════ -->
  <!-- ══ KARRIERE ═══════════════════════════════════════════════════════ -->
  <section class="jobs zone-dark" id="karriere">
    <div class="wrap jobs__inner">
      <div class="jobs__pitch">
        <p class="label jobs__eyebrow">Karriere</p>
        <h2>Wir stellen ein.</h2>
        <p class="jobs__text">
          Zehn Leute, {jobs.length} offene Stellen. Wer bei uns anfängt, lernt das
          Handwerk auf der Baustelle — und arbeitet an Objekten, die andere nicht
          anfassen dürfen.
        </p>
        <a href="/karriere/" class="btn btn--primary jobs__cta">
          Offene Stellen ansehen
          <svg class="btn__arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
      </div>

      <ol class="jobs__list" role="list">
        {jobs.map((j, i) => (
          <li>
            <a href="/karriere/#bewerbung">
              <span class="jobs__no num">{String(i + 1).padStart(2, '0')}</span>
              <span class="jobs__t">
                <span class="jobs__title">{j.data.title}</span>
                <span class="jobs__meta label">{j.data.field}<span aria-hidden="true"> · </span>{j.data.type}</span>
              </span>
              <svg class="jobs__arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */
  /* Der Hero nimmt den Bildschirm. Das Foto ist der Auftritt, nicht Dekoration
     hinter einem Farbschleier — deshalb voller Anschnitt und nur so viel
     Abdunklung, wie die Schrift zum Lesen braucht. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    background: var(--ink);
    color: var(--dust);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 46% 52%;
    opacity: 1;
    filter: grayscale(.55) contrast(1.16) brightness(.82);
    transform: scale(var(--hero-scale, 1.06));
    transform-origin: 50% 55%;
    will-change: transform;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, #0B0C0E 0%, rgba(11,12,14,.58) 34%, rgba(11,12,14,.14) 72%, rgba(11,12,14,.55) 100%),
      linear-gradient(98deg, rgba(11,12,14,.90) 0%, rgba(11,12,14,.80) 32%, rgba(11,12,14,.36) 62%, rgba(11,12,14,.10) 100%);
  }

  .hero__body { padding-block: 8rem var(--s-8); margin-top: auto; }
  @media (min-width: 48rem) { .hero__body { padding-block: 11rem var(--s-9); } }

  /* Über dem Foto ist der Kontrast nicht messbar — deshalb bewusst hell. */
  .hero__kicker { color: color-mix(in oklab, var(--dust) 84%, transparent); margin-bottom: var(--s-5); }

  .hero__head {
    font-size: var(--t-mega);
    font-weight: 800;
    font-stretch: 106%;
    line-height: .92;
    letter-spacing: -.035em;
    max-width: 26ch;
    text-wrap: initial;
  }
  .hero__head span { display: inline; }
  @media (min-width: 34rem) { .hero__head span { display: block; } }
  .hero__lead {
    margin-top: var(--s-7);
    max-width: 44ch;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: color-mix(in oklab, var(--dust) 78%, transparent);
  }
  .hero__lead strong { color: var(--dust); font-weight: 600; }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-7); }

  .hero__data { border-top: 1px solid color-mix(in oklab, var(--dust) 20%, transparent); }
  .hero__data-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  @media (min-width: 48rem) { .hero__data-grid { grid-template-columns: repeat(4, 1fr); } }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: .3rem;
