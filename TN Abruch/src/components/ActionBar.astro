---
import { company } from '~/data/company';
---

<nav class="actionbar" data-actionbar aria-label="Schnellkontakt">
  <a href={company.phoneHref} class="actionbar__item actionbar__item--call">
    <svg viewBox="0 0 16 16" aria-hidden="true" width="15" height="15">
      <path d="M4.2 1.8 6 4.4 4.6 6.2c.9 1.9 2.3 3.3 4.2 4.2l1.8-1.4 2.6 1.8-.4 2.4c-.1.5-.6.9-1.1.8C6.5 13.3 2.7 9.5 1.8 3.7c-.1-.5.3-1 .8-1.1l1.6-.8Z"
        fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
    </svg>
    <span>Anrufen</span>
  </a>
  <a href="/kontakt/" class="actionbar__item actionbar__item--ask">
    <span>Projekt anfragen</span>
  </a>
</nav>

<style>
  .actionbar {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 90;
    display: grid;
    grid-template-columns: auto 1fr;
    border-top: 1px solid color-mix(in oklab, #EDEAE4 22%, transparent);
    background: #0B0C0E;
    padding-bottom: env(safe-area-inset-bottom);
    transform: translateY(102%);
    transition: transform 320ms var(--ease-mass);
  }
  .actionbar.is-visible { transform: none; }

  .actionbar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 3.5rem;
    padding-inline: 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: .9375rem;
    text-decoration: none;
    transition: background-color var(--dur-ui) linear;
  }
  .actionbar__item--call { color: #EDEAE4; border-right: 1px solid color-mix(in oklab, #EDEAE4 22%, transparent); }
  .actionbar__item--call:active { background: #1E2126; }
  .actionbar__item--ask { background: var(--signal); color: #F7F5F1; }
  .actionbar__item--ask:active { background: var(--signal-deep); }
  .actionbar__item:focus-visible { outline-offset: -3px; }

  @media (min-width: 62rem) { .actionbar { display: none; } }
  @media (prefers-reduced-motion: reduce) { .actionbar { transition: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-actionbar]');
  if (bar) {
    // Erscheint, sobald der erste Bildschirm verlassen wurde, und bleibt dann.
    const show = () => {
      if (window.scrollY > window.innerHeight * 0.6) {
        bar.classList.add('is-visible');
        removeEventListener('scroll', show);
      }
    };
    addEventListener('scroll', show, { passive: true });
    show();
  }
</script>
