---
/**
 * Deckblatt für Unterseiten.
 *
 * Vorher: schwarze Fläche mit Titel. Das war sauber, wirkte aber unfertig —
 * jede Unterseite fing mit einem leeren Rechteck an. Jetzt liegt eine
 * Materialaufnahme darunter, gedeckelt von einem Schleier, der den Text traegt.
 * Die Kennzahlenleiste bleibt auf voller Deckung: dort muss der Kontrast
 * messbar stimmen, nicht ungefaehr.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  facts?: { value: string; label: string }[];
  breadcrumb?: { name: string; href: string }[];
  /** Materialaufnahme im Kopf. Ohne Bild bleibt der Kopf schwarz. */
  image?: ImageMetadata;
  /** Beschreibt ausschliesslich das Material, nie ein Projekt. */
  imageAlt?: string;
}
const { eyebrow, title, lead, facts, breadcrumb, image, imageAlt } = Astro.props;
---

<section class="ph zone-dark" data-media={image ? '' : undefined}>
  <div class="ph__top">
    {image && (
      <div class="ph__media" aria-hidden={imageAlt ? undefined : 'true'}>
        <Image
          src={image}
          alt={imageAlt ?? ''}
          widths={[900, 1400, 2000]}
          sizes="100vw"
          format="avif"
          quality={68}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}

    <div class="wrap ph__body">
      {breadcrumb && (
        <nav class="ph__crumbs" aria-label="Brotkrumennavigation">
          <ol role="list">
            {breadcrumb.map((b, i) => (
              <li>
                {i < breadcrumb.length - 1
                  ? <a href={b.href}>{b.name}</a>
                  : <span aria-current="page">{b.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}

      <p class="ph__eyebrow label">{eyebrow}</p>
      <h1 class="ph__title">{title}</h1>
      {lead && <p class="ph__lead">{lead}</p>}
    </div>
  </div>

  {facts && (
    <div class="ph__facts">
      <div class="wrap ph__facts-grid">
        {facts.map((f) => (
          <div class="ph__fact">
            <span class="ph__fact-v num">{f.value}</span>
            <span class="ph__fact-l">{f.label}</span>
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .ph { background: var(--bg); color: var(--fg); }

  .ph__top { position: relative; isolation: isolate; }

  .ph__media { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .ph__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Die Materialstudien sind bewusst dunkel abgestimmt. Im Kopf brauchen sie
       eine Spur mehr Licht, sonst sieht man die Struktur nicht. */
    filter: brightness(1.06) contrast(1.02);
  }

  /* Der Schleier steht links, wo die Schrift steht — nicht ueber dem ganzen
     Bild. Ein flaechiger Schleier hatte das Material auf Schwarz gedrueckt;
     so bleibt rechts sichtbar, worum es geht. */
  .ph[data-media] .ph__top::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg,
        rgba(11, 12, 14, .95) 0%,
        rgba(11, 12, 14, .89) 32%,
        rgba(11, 12, 14, .48) 60%,
        rgba(11, 12, 14, .16) 86%,
        rgba(11, 12, 14, .08) 100%),
      linear-gradient(180deg,
        rgba(11, 12, 14, .68) 0%,
        rgba(11, 12, 14, .04) 24%,
        rgba(11, 12, 14, .04) 72%,
        rgba(11, 12, 14, .34) 100%);
  }
  /* Auf schmalen Screens laeuft der Text ueber die volle Breite — dort muss
     der Schleier wieder flaechig decken. */
  @media (max-width: 47.99rem) {
    .ph[data-media] .ph__top::after {
      background: linear-gradient(180deg,
        rgba(11, 12, 14, .90) 0%,
        rgba(11, 12, 14, .74) 32%,
        rgba(11, 12, 14, .80) 70%,
        rgba(11, 12, 14, .95) 100%);
    }
  }

  .ph__body { padding-top: calc(4.25rem + var(--s-8)); padding-bottom: var(--s-8); }
  @media (min-width: 62rem) { .ph__body { padding-top: calc(4.25rem + var(--s-9)); } }
  .ph[data-media] .ph__body {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(22rem, 44vw, 34rem);
    padding-bottom: var(--s-9);
  }
  .ph:not(:has(.ph__facts)) .ph__body { padding-bottom: var(--s-9); }

  .ph__crumbs { margin-bottom: var(--s-6); }
  .ph__crumbs ol { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .ph__crumbs li {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .ph[data-media] .ph__crumbs li { color: color-mix(in oklab, var(--dust) 78%, transparent); }
  .ph__crumbs li + li::before { content: '/'; margin-right: .5rem; opacity: .55; }
  .ph__crumbs a { display: inline-flex; align-items: center; min-height: 32px; text-decoration: none; }
  .ph__crumbs a:hover { color: var(--accent); text-decoration: underline; }
  .ph__crumbs [aria-current] { color: var(--fg); }

  @media (pointer: coarse) {
    .ph__crumbs { margin-bottom: var(--s-5); }
    .ph__crumbs a { min-height: 44px; }
  }

  .ph__eyebrow { color: var(--accent); margin-bottom: var(--s-4); }
  .ph__title { font-size: var(--t-h1); font-stretch: 104%; max-width: 18ch; }
  .ph[data-media] .ph__body > * { max-width: 46rem; }
  .ph__lead {
    margin-top: var(--s-5);
    max-width: 56ch;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: color-mix(in oklab, currentColor 78%, transparent);
  }
  /* Ueber dem Bild braucht die Kurzfassung volle Deckung. */
  .ph[data-media] .ph__lead { color: color-mix(in oklab, var(--dust) 92%, transparent); }

  /* Kennzahlenleiste: eigene, volle Flaeche — keine Messung gegen ein Bild. */
  .ph__facts { position: relative; background: var(--ink); border-top: 1px solid var(--rule); }
  .ph__facts-grid { display: grid; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 48rem) { .ph__facts-grid { grid-template-columns: repeat(4, 1fr); } }

  .ph__fact {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding: var(--s-5) var(--s-4) var(--s-5) var(--s-4);
    border-left: 1px solid var(--rule);
  }
  .ph__fact:first-child { border-left: 0; padding-left: 0; }
  @media (max-width: 47.99rem) {
    .ph__fact:nth-child(3) { border-left: 0; padding-left: 0; }
    .ph__fact:nth-child(-n+2) { border-bottom: 1px solid var(--rule); }
  }
  .ph__fact-v {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.2vw, 2rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.03em;
    font-variant-numeric: tabular-nums;
  }
  .ph__fact-l { font-size: var(--t-xs); color: var(--fg-muted); line-height: 1.35; }
</style>
