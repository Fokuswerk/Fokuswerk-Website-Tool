---
import '../styles/system.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { firma } from '../data/firma';

interface Props {
  titel: string;
  beschreibung: string;
  bild?: string;
  noindex?: boolean;
}
const { titel, beschreibung, bild = '/og-fokuswerk.jpg', noindex = false } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site).href;
const ogBild = new URL(bild, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Fokuswerk" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={ogBild} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f5f2ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/schibsted-grotesk-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'Fokuswerk',
      description:
        'Fokuswerk produziert an einem Drehtag im Monat das Material für zwei laufende Kampagnen: eine für Mitarbeiter, eine für Kunden. Für Betriebe mit eigener Werkstatt und hochpreisiges Handwerk in Nordwest-Niedersachsen.',
      url: 'https://fokuswerk.de',
      telephone: '+4917663307587',
      email: 'contact@fokuswerk.de',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Schramperweg 90',
        postalCode: '26129',
        addressLocality: 'Oldenburg',
        addressCountry: 'DE',
      },
      areaServed: 'Nordwest-Niedersachsen',
      vatID: 'DE456629159',
    })} />
  </head>

  <body>
    <a href="#inhalt" class="skip">Zum Inhalt springen</a>
    <Kopf />
    <main id="inhalt"><slot /></main>
    <Fuss />
    <script>import '../scripts/bewegung';</script>
  </body>
</html>
