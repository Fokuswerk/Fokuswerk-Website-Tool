---
import Basis from '../layouts/Basis.astro';
import Abschnitt from '../components/Abschnitt.astro';
import Titel from '../components/Titel.astro';
import Pfeil from '../components/Pfeil.astro';
import Haken from '../components/Haken.astro';
import { firma } from '../data/firma';

const ablauf = [
  'Sie schildern kurz, wie es gerade läuft: offene Stellen, Auslastung, was Sie im Monat an Aufträgen abgeben.',
  'Wir rechnen mit Ihren Zahlen durch, ob sich das für Ihren Betrieb trägt.',
  'Danach sagen wir Ihnen, ob wir zusagen würden — oder warum nicht.',
];
---

<Basis
  titel="Kontakt — Gespräch vereinbaren | Fokuswerk Oldenburg"
  beschreibung="20 Minuten am Telefon: Wir gehen Ihre Zahlen durch und sagen Ihnen, ob sich ein Drehtag im Monat für Ihren Betrieb rechnet. Fokuswerk, Oldenburg."
>
  <section class="kon-kopf">
    <div class="huelle">
      <div class="kon-kopf-raster">
        <p class="label kon-augen" data-auf>Kontakt</p>
        <Titel zeilen={['Zwanzig Minuten,', 'am Telefon.']} stufe="h1" groesse="d1" klasse="kon-titel" />
        <p class="lead kon-lead" data-auf style="--verzug:280ms">
          Kein Pitch, keine Präsentation, kein Verkaufsgespräch mit zweitem Termin.
          Ein Anruf, an dessen Ende Sie wissen, ob sich das für Ihren Betrieb rechnet.
        </p>
      </div>
    </div>
  </section>

  <Abschnitt nummer="01" marke="Anfrage" hoehe="eng">
    <div class="kon-raster">
      <div class="kon-form-block">
        <form class="kon-form" method="post" action="/api/anfrage" novalidate>
          <div class="feld">
            <label for="betrieb">Betrieb</label>
            <input type="text" id="betrieb" name="betrieb" autocomplete="organization" required />
          </div>

          <div class="feld-paar">
            <div class="feld">
              <label for="name">Ihr Name</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>
            <div class="feld">
              <label for="telefon">Telefon</label>
              <input type="tel" id="telefon" name="telefon" autocomplete="tel" required />
            </div>
          </div>

          <div class="feld">
            <label for="email">E-Mail</label>
            <input type="email" id="email" name="email" autocomplete="email" required />
          </div>

          <div class="feld">
            <label for="lage">Worum geht es? <span class="feld-opt">optional</span></label>
            <textarea id="lage" name="lage" rows="4"
              placeholder="Zum Beispiel: seit acht Monaten eine Stelle offen, zwei Bühnen, Termine drei Wochen im Voraus."></textarea>
          </div>

          <div class="feld-hinweis">
            <p class="klein">
              Wir melden uns innerhalb eines Werktags. Ihre Angaben verwenden wir
              ausschließlich zur Beantwortung dieser Anfrage — Näheres in der
              <a href="/datenschutz/">Datenschutzerklärung</a>.
            </p>
          </div>

          <p class="feld-falle" aria-hidden="true">
            <label for="webseite">Bitte leer lassen</label>
            <input type="text" id="webseite" name="webseite" tabindex="-1" autocomplete="off" />
          </p>

          <button type="submit" class="knopf">Anfrage senden<Pfeil /></button>

          <p class="kon-fehler" data-fehler hidden role="alert"></p>
        </form>
      </div>

      <aside class="kon-direkt">
        <div class="kon-block">
          <p class="label">Direkt</p>
          <a href={`tel:${firma.telefon}`} class="kon-tel ziffer">{firma.telefonAnzeige}</a>
          <a href={`mailto:${firma.mail}`} class="kon-mail">{firma.mail}</a>
          <p class="klein kon-zeit">Werktags 8 bis 18 Uhr. Wenn niemand rangeht, sind wir auf einem Drehtag — rufen Sie später noch einmal an oder schreiben Sie kurz.</p>
        </div>

        <div class="kon-block">
          <p class="label">Was im Gespräch passiert</p>
          <ul class="liste-strich kon-ablauf">
            {ablauf.map((t) => <li><Haken />{t}</li>)}
          </ul>
        </div>

        <div class="kon-block">
          <p class="label">Anschrift</p>
          <address class="kon-adresse">
            {firma.rechtsform}<br />
            {firma.strasse}<br />
            {firma.plz} {firma.ort}
          </address>
        </div>
      </aside>
    </div>
  </Abschnitt>
</Basis>

<style>
  .kon-kopf { padding-top: clamp(7rem, 15vh, 11rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
  .kon-augen { display: block; margin-bottom: clamp(1.25rem, 2.5vw, 2rem); }
  .kon-titel { max-width: 16ch; }
  .kon-lead { margin-top: clamp(1.5rem, 3vw, 2.25rem); max-width: 46ch; }
  @media (min-width: 56rem) {
    .kon-kopf-raster {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 6vw, 6rem);
      align-items: end;
    }
    .kon-augen { grid-column: 1 / -1; }
    .kon-lead { margin-top: 0; padding-bottom: 0.35em; }
  }

  .kon-raster { display: grid; gap: clamp(2.5rem, 6vw, 4.5rem); }
  @media (min-width: 62rem) {
    .kon-raster {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }
  }

  /* ---------- Formular ---------- */
  .kon-form { display: grid; gap: var(--r-4); }
  .feld { display: grid; gap: 0.45rem; }
  .feld-paar { display: grid; gap: var(--r-4); }
  @media (min-width: 34rem) { .feld-paar { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .feld label {
    font-family: var(--schrift-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinte-2);
  }
  .feld-opt { font-weight: 500; letter-spacing: 0.06em; color: var(--tinte-3); text-transform: none; }

  .feld input, .feld textarea {
    font-family: var(--schrift-display);
    font-size: 1rem;
    color: var(--tinte);
    background: var(--weiss);
    border: 1px solid var(--linie-stark);
    border-radius: var(--radius);
    padding: 0.9em 0.95em;
    width: 100%;
    transition: border-color .3s var(--ease), background .3s var(--ease);
  }
  .feld textarea { resize: vertical; min-height: 7rem; line-height: 1.55; }
  .feld input::placeholder, .feld textarea::placeholder { color: var(--tinte-3); }
  .feld input:focus, .feld textarea:focus { border-color: var(--tinte); outline: none; }
  .feld input:focus-visible, .feld textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .feld input:user-invalid, .feld textarea:user-invalid { border-color: var(--signal); }

  .feld-hinweis .klein { max-width: 52ch; }
  .feld-hinweis a { text-decoration: underline; text-underline-offset: 0.2em; }

  .feld-falle { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .kon-form .knopf { justify-self: start; }
  .kon-fehler {
    font-family: var(--schrift-display);
    font-size: 0.9rem;
    color: var(--signal);
    padding: 0.8em 0.95em;
    border: 1px solid var(--signal);
    border-radius: var(--radius);
  }

  /* ---------- Direktspalte ---------- */
  .kon-direkt { display: grid; gap: clamp(1.75rem, 4vw, 2.75rem); align-content: start; }
  .kon-block { padding-top: clamp(1.25rem, 2.5vw, 1.6rem); border-top: 1px solid var(--linie); }
  .kon-block:first-child { padding-top: 0; border-top: 0; }
  .kon-block .label { display: block; margin-bottom: 1em; }

  .kon-tel {
    display: block;
    font-family: var(--schrift-display);
    font-size: clamp(1.6rem, 1.2rem + 1.7vw, 2.35rem);
    font-weight: 600;
    letter-spacing: -0.032em;
    width: fit-content;
  }
  .kon-mail {
    display: block;
    font-family: var(--schrift-display);
    font-size: 1rem;
    color: var(--tinte-2);
    margin-top: 0.35rem;
    padding-block: 0.4em;
    width: fit-content;
  }
  .kon-tel:hover, .kon-mail:hover { color: var(--signal); }
  .kon-zeit { margin-top: 1rem; max-width: 40ch; }

  .kon-ablauf > li { font-family: var(--schrift-display); font-size: 0.95rem; line-height: 1.55; }
  .kon-ablauf > li:first-child { border-top: 0; padding-top: 0; }

  .kon-adresse {
    font-family: var(--schrift-display);
    font-style: normal;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--tinte-2);
  }
</style>

<script>
  const formular = document.querySelector<HTMLFormElement>('.kon-form');
  const fehlerfeld = document.querySelector<HTMLElement>('[data-fehler]');

  formular?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!formular.reportValidity()) return;

    const knopf = formular.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const beschriftung = knopf.textContent;
    knopf.disabled = true;
    knopf.textContent = 'Wird gesendet …';
    fehlerfeld!.hidden = true;

    try {
      const antwort = await fetch('/api/anfrage', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(formular))),
      });
      if (!antwort.ok) throw new Error(String(antwort.status));
      window.location.href = '/danke/';
    } catch {
      knopf.disabled = false;
      knopf.textContent = beschriftung;
      fehlerfeld!.hidden = false;
      fehlerfeld!.textContent =
        'Das Senden hat gerade nicht geklappt. Rufen Sie uns an unter 0176 63307587 oder schreiben Sie an contact@fokuswerk.de — wir melden uns umgehend.';
    }
  });
</script>
