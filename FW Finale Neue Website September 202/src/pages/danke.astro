---
import Basis from '../layouts/Basis.astro';
import Titel from '../components/Titel.astro';
import Pfeil from '../components/Pfeil.astro';
import { firma } from '../data/firma';
---

<Basis
  titel="Danke — Ihre Anfrage ist angekommen | Fokuswerk"
  beschreibung="Ihre Anfrage bei Fokuswerk ist eingegangen. Wir melden uns innerhalb eines Werktags."
  noindex
>
  <section class="dnk">
    <div class="huelle dnk-innen">
      <p class="label" data-auf>Angekommen</p>
      <Titel zeilen={['Wir melden uns', 'innerhalb eines', 'Werktags.']} stufe="h1" groesse="d2" klasse="dnk-titel" />
      <p class="lead dnk-lead" data-auf style="--verzug:280ms">
        Meistens schneller. Wenn es eilig ist, rufen Sie einfach direkt an — dann
        klären wir es in zwanzig Minuten.
      </p>

      <div class="dnk-direkt" data-auf style="--verzug:360ms">
        <a href={`tel:${firma.telefon}`} class="dnk-tel ziffer">{firma.telefonAnzeige}</a>
        <a href="/fallstudien/wav-westerstede/" class="link">In der Zwischenzeit: die Fallstudie WAV<Pfeil /></a>
      </div>
    </div>
  </section>
</Basis>

<style>
  .dnk { display: grid; align-items: center; min-height: 78svh; padding-block: clamp(7rem, 15vh, 10rem) var(--r-8); }
  .dnk-innen { width: 100%; }
  .dnk .label { display: block; margin-bottom: clamp(1rem, 2vw, 1.5rem); }
  .dnk-titel { max-width: 16ch; }
  .dnk-lead { margin-top: clamp(1.5rem, 3vw, 2.25rem); max-width: 44ch; }
  .dnk-direkt {
    display: grid; gap: var(--r-3); justify-items: start;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--linie);
  }
  .dnk-tel {
    font-family: var(--schrift-display);
    font-size: clamp(1.6rem, 1.2rem + 1.7vw, 2.35rem);
    font-weight: 600; letter-spacing: -0.032em;
  }
  .dnk-tel:hover { color: var(--signal); }
</style>
