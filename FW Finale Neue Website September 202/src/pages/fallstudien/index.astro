---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import Abschnitt from '../../components/Abschnitt.astro';
import Pfeil from '../../components/Pfeil.astro';
import SchlussCta from '../../components/SchlussCta.astro';
import { fallstudien } from '../../data/fallstudien';

const bilder = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.jpg', { eager: true });
const holen = (name: string) => bilder[`../../assets/${name}.jpg`].default;
---

<Basis
  titel="Fallstudien — belegte Ergebnisse | Fokuswerk"
  beschreibung="Fallstudien von Fokuswerk mit Zahlen aus den Werbekonten: WAV Westerstede, 550 € Werbebudget, 68 Bewerbungen, Mechatroniker nach 14 Tagen."
>
  <SeitenKopf
    augen="Fallstudien"
    zeilen={['Was tatsächlich', 'herausgekommen ist.']}
    lead="Eine Fallstudie steht hier erst, wenn der Betrieb seine Zahlen freigegeben hat und wir sie aus dem Werbekonto belegen können. Deshalb ist die Liste kurz — und jede Zahl darauf nachprüfbar."
  />

  <Abschnitt nummer="01" marke="Belegt">
    <ul class="fst-liste">
      {fallstudien.map((f) => (
        <li>
          <a href={`/fallstudien/${f.slug}/`} class="fst" data-auf>
            <div class="bild fst-bild" data-zoom>
              <Image
                src={holen(f.bild)}
                alt={`Aufnahme aus dem Betrieb ${f.betrieb}`}
                widths={[560, 860, 1200]}
                sizes="(min-width: 62rem) 46vw, 100vw"
                quality={80}
                loading="lazy"
              />
            </div>

            <div class="fst-text">
              <p class="label fst-meta">{f.branche}<span class="punkt">·</span>{f.ort}</p>
              <h2 class="d3 fst-titel">{f.betrieb}</h2>
              <p class="fliess fliess-2 fst-kurz">{f.kurz}</p>

              <ul class="fst-zahlen">
                {f.kennzahlen.map((k) => (
                  <li>
                    <span class="fst-wert ziffer">{k.wert}</span>
                    <span class="fst-label">{k.label}</span>
                  </li>
                ))}
              </ul>

              <span class="link">Fallstudie ansehen<Pfeil /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <p class="quelle fst-hinweis">
      Weitere Fallstudien folgen, sobald die betreffenden Betriebe ihre Zahlen
      freigeben. Wir veröffentlichen keine, die wir nicht aus einem Werbekonto oder
      einer Rechnung belegen können — auch dann nicht, wenn das Ergebnis gut war.
    </p>
  </Abschnitt>

  <SchlussCta
    zeilen={['Sprechen Sie', 'mit unserem', 'Kunden.']}
    text="Alexander Lüers von WAV Westerstede ist als Referenz freigegeben. Wenn Sie wissen wollen, wie die Zusammenarbeit aus seiner Sicht aussah, geben wir Ihnen seine Nummer — Sie müssen dafür nichts unterschreiben und nichts buchen."
  />
</Basis>

<style>
  .fst-liste { display: grid; gap: clamp(3rem, 7vw, 5rem); }
  .fst { display: grid; gap: clamp(1.5rem, 3.5vw, 2.5rem); }
  @media (min-width: 62rem) {
    .fst { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  }
  .fst-bild { aspect-ratio: 4 / 3; }
  .fst :global(img) { transition: scale 1s var(--ease); }
  .fst:hover :global(img) { scale: 1.035; }

  .fst-meta { display: flex; flex-wrap: wrap; align-items: baseline; margin-bottom: 0.9em; }
  .fst-titel { margin-bottom: 0.5em; }
  .fst-kurz { max-width: 48ch; }
  .fst-zahlen {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
    margin-block: clamp(1.5rem, 3vw, 2rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.6rem);
    border-top: 1px solid var(--linie);
  }
  @media (min-width: 30rem) { .fst-zahlen { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .fst-zahlen li { display: grid; gap: 0.2rem; align-content: start; }
  .fst-wert {
    font-family: var(--schrift-display);
    font-size: clamp(1.25rem, 1.05rem + 0.85vw, 1.7rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .fst-label {
    font-family: var(--schrift-display);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinte-3);
    line-height: 1.4;
  }
  .fst:hover .link::after { transform: scaleX(0); transform-origin: right; }
  .fst:hover .link :global(.pfeil) { translate: 0.28em 0; }

  .fst-hinweis { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
</style>
