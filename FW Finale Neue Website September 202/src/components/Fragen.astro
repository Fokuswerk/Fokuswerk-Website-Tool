---
import Abschnitt from './Abschnitt.astro';
import Titel from './Titel.astro';

interface Frage { frage: string; antwort: string }
interface Props { nummer?: string; fragen: Frage[]; zeilen?: string[] }
const { nummer = '12', fragen, zeilen = ['Was Betriebe', 'vorher fragen.'] } = Astro.props;
---

<Abschnitt nummer={nummer} marke="Fragen" id="fragen">
  <div class="frg-raster">
    <div class="frg-kopf">
      <Titel zeilen={zeilen} stufe="h2" groesse="d3" />
    </div>

    <div class="frg-liste">
      {fragen.map((f, i) => (
        <details class="frg" name="fragen" data-auf style={`--verzug:${i * 60}ms`}>
          <summary>
            <span class="frg-frage">{f.frage}</span>
            <span class="frg-zeichen" aria-hidden="true"></span>
          </summary>
          <div class="frg-antwort"><p class="fliess fliess-2">{f.antwort}</p></div>
        </details>
      ))}
    </div>
  </div>
</Abschnitt>

<style>
  .frg-raster { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 62rem) {
    .frg-raster { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
    .frg-kopf { position: sticky; top: 8rem; }
  }

  .frg-liste { border-top: 1px solid var(--linie); }
  .frg { border-bottom: 1px solid var(--linie); }

  .frg summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--r-4);
    padding-block: clamp(1.1rem, 2.4vw, 1.5rem);
    cursor: pointer;
    list-style: none;
  }
  .frg summary::-webkit-details-marker { display: none; }
  .frg-frage {
    font-family: var(--schrift-display);
    font-size: clamp(1.02rem, 0.96rem + 0.3vw, 1.22rem);
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.35;
    max-width: 40ch;
    transition: color .35s var(--ease);
  }
  .frg summary:hover .frg-frage { color: var(--signal); }

  .frg-zeichen {
    position: relative;
    flex: none;
    width: 13px; height: 13px;
    translate: 0 0.15em;
  }
  .frg-zeichen::before, .frg-zeichen::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform .45s var(--ease), opacity .45s var(--ease);
  }
  .frg-zeichen::before { left: 0; right: 0; top: 6px; height: 1.5px; }
  .frg-zeichen::after  { top: 0; bottom: 0; left: 6px; width: 1.5px; }
  .frg[open] .frg-zeichen::after { transform: scaleY(0); opacity: 0; }

  .frg-antwort {
    padding-bottom: clamp(1.25rem, 2.6vw, 1.75rem);
    padding-right: clamp(0rem, 4vw, 3rem);
  }
  .frg-antwort p { max-width: 58ch; }

  @media (prefers-reduced-motion: no-preference) {
    .frg[open] .frg-antwort { animation: aufklappen .5s var(--ease); }
    @keyframes aufklappen {
      from { opacity: 0; transform: translateY(-6px); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>
