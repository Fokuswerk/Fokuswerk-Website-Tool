---
import Titel from './Titel.astro';

/**
 * Der Kopf eines Abschnitts als Kaskade: Überschrift über die volle Breite,
 * der Lead eingerückt darunter. Zwei Textblöcke nebeneinander auf gleicher
 * Oberkante lassen einen Abschnitt eng wirken — die Treppe nicht.
 */
interface Props {
  zeilen: string[];
  lead?: string;
  groesse?: 'd1' | 'd2' | 'd3';
  stufe?: 'h1' | 'h2';
  breit?: boolean;
}
const { zeilen, lead, groesse = 'd2', stufe = 'h2', breit = false } = Astro.props;
---

<div class:list={['akopf', breit && 'akopf-breit']}>
  <Titel zeilen={zeilen} stufe={stufe} groesse={groesse} klasse="akopf-titel" />
  {lead && <p class="lead akopf-lead" data-auf style="--verzug:160ms">{lead}</p>}
</div>

<style>
  .akopf { padding-bottom: clamp(2.75rem, 5.8vw, 5.25rem); }
  .akopf-titel { max-width: 20ch; }
  .akopf-breit .akopf-titel { max-width: 26ch; }

  .akopf-lead {
    margin-top: clamp(1.6rem, 3.2vw, 2.75rem);
    max-width: 47ch;
  }
  /* Die Einrückung erzeugt die Stufe. Sie richtet sich nicht an einer
     Rasterspalte aus, sondern an der Lesekante — das wirkt gesetzt. */
  @media (min-width: 56rem) {
    .akopf-lead { margin-left: clamp(5rem, 27%, 18rem); }
  }
</style>
