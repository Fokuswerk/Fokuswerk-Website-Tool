---
interface Props { hoehe?: number; klasse?: string }
const { hoehe = 20, klasse = '' } = Astro.props;
---
<span class:list={['wortmarke', klasse]} style={`--h:${hoehe}px`} aria-hidden="true"></span>
<span class="nur-sr">Fokuswerk</span>

<style>
  .wortmarke {
    display: block;
    height: var(--h);
    aspect-ratio: 982 / 96;
    background: currentColor;
    -webkit-mask: url('/fokuswerk-wortmarke.png') center / contain no-repeat;
    mask: url('/fokuswerk-wortmarke.png') center / contain no-repeat;
  }
</style>
