---
import { Image } from 'astro:assets';
import { cta } from '../../data/firma';
import Pfeil from '../Pfeil.astro';
import bild from '../../assets/hero-hoch.jpg';

const belege = [
  { wert: '550,27 €', label: 'Werbebudget' },
  { wert: '68',       label: 'Bewerbungen' },
  { wert: '14 Tage',  label: 'bis zur Unterschrift' },
];
---

<section class="hero">
  <div class="hero-oben">
    <div class="hero-text">
      <p class="hero-augen" data-auf>
        <span class="hero-augen-strich" aria-hidden="true"></span>
        Für Betriebe mit eigener Werkstatt<span class="punkt">·</span>Nordwest&#8209;Niedersachsen
      </p>

      <h1 class="hero-titel d1" data-zeilen>
        <span class="zeile" style="--verzug:120ms"><span>Ein Drehtag.</span></span>
        <span class="zeile" style="--verzug:200ms"><span>Zwei Kampagnen:</span></span>
        <span class="zeile" style="--verzug:280ms"><span>Mitarbeiter</span></span>
        <span class="zeile" style="--verzug:360ms"><span>und Kunden.</span></span>
      </h1>

      <p class="hero-lead lead" data-auf style="--verzug:480ms">
        Ein halber Tag Dreh bei Ihnen im Betrieb. Daraus laufen den ganzen Monat
        zwei Kampagnen — eine für Bewerbungen, eine für Anfragen.
      </p>

      <div class="hero-aktion" data-auf style="--verzug:560ms">
        <a href={cta.ziel} class="knopf">{cta.primaer}<Pfeil /></a>
        <p class="knopf-notiz">{cta.notiz}</p>
      </div>
    </div>

    <figure class="hero-bild" data-zoom>
      <Image
        src={bild}
        alt="Ein Kameramann filmt einen Kfz-Mechatroniker, der unter einem angehobenen Fahrzeug arbeitet."
        widths={[600, 900, 1300, 1900]}
        sizes="(min-width: 62rem) 42vw, 100vw"
        quality={82}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <figcaption class="hero-bu">Drehtag bei einer Kfz&#8209;Werkstatt im Ammerland</figcaption>
    </figure>
  </div>

  <div class="hero-sockel">
    <div class="huelle hero-sockel-innen">
      <ul class="hero-zahlen">
        {belege.map((b) => (
          <li>
            <span class="hero-wert ziffer">{b.wert}</span>
            <span class="hero-label">{b.label}</span>
          </li>
        ))}
      </ul>
      <a href="/fallstudien/wav-westerstede/" class="hero-quelle">
        <span>WAV Westerstede, Kfz&#8209;Werkstatt<span class="punkt">·</span>Fallstudie ansehen</span>
        <Pfeil groesse={13} />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
  }

  .hero-oben { display: grid; }
  @media (min-width: 62rem) {
    .hero-oben {
      grid-template-columns: minmax(0, 1fr) clamp(22rem, 40vw, 38rem);
      align-items: stretch;
    }
  }

  /* ---------- Textseite ---------- */
  .hero-text {
    display: grid;
    align-content: center;
    gap: clamp(1.15rem, 2vw, 1.65rem);
    padding-inline: var(--rand-links) var(--rand);
    padding-block: clamp(5.75rem, 10.5vh, 7.25rem) clamp(1.75rem, 3.2vw, 2.75rem);
  }
  @media (min-width: 62rem) {
    .hero-text { padding-inline: var(--rand-links) clamp(2.5rem, 5vw, 5rem); }
  }

  .hero-augen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-family: var(--schrift-display);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--tinte-2);
  }
  .hero-augen-strich {
    width: 2.2rem; height: 1px;
    background: var(--linie-stark);
    margin-right: 1.1rem;
    flex: none;
  }

  .hero-titel { max-width: none; }

  .hero-lead { max-width: 50ch; }
  .hero-aktion { display: grid; gap: var(--r-2); justify-items: start; margin-top: 0.4rem; }

  /* ---------- Bildseite ---------- */
  .hero-bild {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--sand-tief);
  }
  /* Schleier oben, damit Telefonnummer und Menü auf jedem Bildausschnitt
     lesbar bleiben — nicht als Effekt, sondern als Lesbarkeitsschicht. */
  .hero-bild::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(6rem, 14vh, 11rem);
    background: linear-gradient(to bottom, rgba(12, 10, 9, 0.5), rgba(12, 10, 9, 0));
    z-index: 1;
    pointer-events: none;
  }
  @media (max-width: 61.999rem) { .hero-bild::before { display: none; } }
  .hero-bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 42%;
  }
  @media (max-width: 61.999rem) {
    .hero-bild { aspect-ratio: 5 / 4; }
  }

  .hero-bu {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 2.5rem clamp(1.1rem, 2.5vw, 1.6rem) clamp(0.9rem, 1.8vw, 1.15rem);
    font-family: var(--schrift-display);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    background: linear-gradient(to top, rgba(12, 10, 9, 0.62), rgba(12, 10, 9, 0));
  }

  /* ---------- Sockel ---------- */
  .hero-sockel {
    border-top: 1px solid var(--linie);
    padding-block: clamp(0.85rem, 1.5vw, 1.2rem);
  }
  .hero-sockel-innen {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--r-3) var(--r-5);
  }
  .hero-zahlen { display: flex; flex-wrap: wrap; gap: clamp(1.25rem, 4vw, 3.5rem); }
  .hero-zahlen li { display: flex; align-items: baseline; gap: 0.55rem; }
  .hero-wert {
    font-family: var(--schrift-display);
    font-size: clamp(1.05rem, 0.92rem + 0.55vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.026em;
    line-height: 1.1;
  }
  .hero-label {
    font-family: var(--schrift-display);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tinte-3);
  }

  .hero-quelle {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--schrift-display);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--tinte-2);
    padding-block: 0.4em;
    position: relative;
  }
  .hero-quelle::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 0.25em;
    height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left;
    transition: transform .5s var(--ease);
  }
  .hero-quelle:hover { color: var(--tinte); }
  .hero-quelle:hover::after { transform: scaleX(1); }
  .hero-quelle :global(.pfeil) { transition: translate .45s var(--ease); }
  .hero-quelle:hover :global(.pfeil) { translate: 0.28em 0; }

  @media (max-width: 61.999rem) {
    .hero { min-height: 0; }
    .hero-zahlen { gap: 1rem 1.75rem; }
    .hero-quelle { font-size: 0.76rem; }
  }
</style>
