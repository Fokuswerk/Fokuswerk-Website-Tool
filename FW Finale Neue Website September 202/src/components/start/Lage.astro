---
import { Image } from 'astro:assets';
import Abschnitt from '../Abschnitt.astro';
import Titel from '../Titel.astro';
import bild from '../../assets/leere-hebebuehne.jpg';

const gruende = [
  {
    titel: 'Die Anzeige wartet.',
    text: 'Ein Jobportal erreicht nur, wer gerade aktiv sucht. Der gute Mechatroniker sucht nicht — er hat einen Job. Er wechselt, wenn ihm jemand etwas Besseres zeigt.',
  },
  {
    titel: 'Bewerben ist zu umständlich.',
    text: 'Lebenslauf, Anschreiben, PDF am Rechner. Abends auf dem Sofa macht das niemand. Was nicht in einer Minute vom Handy geht, passiert nicht.',
  },
  {
    titel: 'Niemand sieht, wie es bei Ihnen aussieht.',
    text: 'Wer Ihre Halle nie gesehen hat, kann nicht wissen, ob er dort arbeiten möchte. Zwei Sätze in einem Portal zeigen davon nichts.',
  },
];
---

<Abschnitt nummer="01" marke="Die Lage">
  <div class="lage-kopf">
    <Titel
      zeilen={['Sie suchen.', 'Es meldet sich', 'niemand.']}
      stufe="h2"
      groesse="d2"
    />
    <div class="lage-lead" data-auf style="--verzug:120ms">
      <p class="lead">
        Die Anzeige läuft seit Monaten. Ein paar Bewerbungen sind gekommen, keine
        hat gepasst. Währenddessen steht eine Bühne halb leer, Termine vergeben Sie
        drei Wochen im Voraus, und Aufträge, die Sie früher angenommen hätten,
        macht jetzt jemand anders.
      </p>
      <p class="lage-satz">Das liegt nicht an Ihrem Betrieb. Es liegt daran, wo gesucht wird.</p>
    </div>
  </div>

  <div class="lage-raster">
    <ol class="lage-gruende">
      {gruende.map((g, i) => (
        <li data-auf style={`--verzug:${i * 90}ms`}>
          <span class="lage-nr ziffer">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="d4">{g.titel}</h3>
            <p class="fliess fliess-2">{g.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <figure class="lage-bild" data-auf style="--verzug:180ms">
      <div class="bild" data-zoom data-parallaxe="26">
        <Image
          src={bild}
          alt="Eine unbenutzte Zwei-Säulen-Hebebühne mit abgesenkten Armen in einer Werkstatthalle."
          widths={[520, 780, 1100]}
          sizes="(min-width: 62rem) 32vw, 100vw"
          quality={80}
          loading="lazy"
        />
      </div>
      <figcaption class="bild-bu">
        Eine Bühne, die nicht läuft, steht in keiner Rechnung. Sie fehlt trotzdem —
        jeden Monat, in derselben Höhe.
      </figcaption>
    </figure>
  </div>
</Abschnitt>

<style>
  .lage-kopf {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  @media (min-width: 56rem) {
    .lage-kopf {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: start;
    }
  }
  .lage-lead { display: grid; gap: 1.15em; }
  .lage-lead .lead { max-width: 48ch; }
  .lage-satz {
    font-family: var(--schrift-display);
    font-size: clamp(1.02rem, 0.97rem + 0.24vw, 1.18rem);
    font-weight: 600;
    letter-spacing: -0.014em;
    line-height: 1.4;
    max-width: 34ch;
  }

  .lage-raster { display: grid; gap: clamp(2.5rem, 6vw, 4.5rem); }
  @media (min-width: 62rem) {
    .lage-raster {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .lage-gruende { display: grid; }
  .lage-gruende > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0 clamp(0.75rem, 2vw, 1.5rem);
    padding-block: clamp(1.4rem, 3vw, 2.1rem);
    border-top: 1px solid var(--linie);
  }
  .lage-gruende > li:last-child { border-bottom: 1px solid var(--linie); }
  .lage-nr {
    font-family: var(--schrift-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--signal);
    padding-top: 0.42em;
  }
  .lage-gruende h3 { margin-bottom: 0.5em; }
  .lage-gruende p { max-width: 54ch; }

  .lage-bild { margin: 0; }
  .lage-bild .bild { aspect-ratio: 4 / 5; }
  @media (min-width: 62rem) {
    .lage-bild { position: sticky; top: 8rem; }
  }
</style>
