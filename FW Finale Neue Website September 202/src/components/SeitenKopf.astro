---
import Titel from './Titel.astro';

interface Props {
  augen: string;
  zeilen: string[];
  lead?: string;
  gross?: boolean;
}
const { augen, zeilen, lead, gross = false } = Astro.props;
---

<section class="skopf">
  <div class="huelle">
    <div class="skopf-raster">
      <p class="label skopf-augen" data-auf>{augen}</p>
      <Titel zeilen={zeilen} stufe="h1" groesse={gross ? 'd1' : 'd2'} klasse="skopf-titel" />
      {lead && <p class="lead skopf-lead" data-auf style="--verzug:280ms">{lead}</p>}
    </div>
  </div>
</section>

<style>
  .skopf {
    padding-top: clamp(7rem, 15vh, 11rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .skopf-augen { display: block; margin-bottom: clamp(1.25rem, 2.5vw, 2rem); }
  .skopf-titel { max-width: 20ch; }
  .skopf-lead {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 50ch;
  }

  /* Ab Tablet steht der Lead neben dem Titel statt darunter — sonst bleibt die
     rechte Bildschirmhälfte auf allen Unterseiten leer. */
  @media (min-width: 56rem) {
    .skopf-raster {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 6vw, 6rem);
      align-items: end;
    }
    .skopf-augen { grid-column: 1 / -1; }
    .skopf-lead { margin-top: 0; padding-bottom: 0.35em; }
  }
</style>
