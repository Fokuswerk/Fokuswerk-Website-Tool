---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  bild: ImageMetadata;
  alt: string;
  bu?: string;
  hoehe?: string;
}
const { bild, alt, bu, hoehe = 'clamp(16rem, 52vh, 34rem)' } = Astro.props;
---

<figure class="band" style={`--band-h:${hoehe}`}>
  <div class="bild" data-zoom data-parallaxe="34">
    <Image src={bild} alt={alt} widths={[900, 1400, 1920, 2400]} sizes="100vw" quality={80} loading="lazy" />
  </div>
  {bu && (
    <figcaption class="huelle">
      <span class="band-bu">{bu}</span>
    </figcaption>
  )}
</figure>

<style>
  .band { margin: 0; }
  .band .bild { height: var(--band-h); border-radius: 0; }
  .band :global(img) { width: 100%; object-fit: cover; }
  .band figcaption { padding-top: 0.85rem; }
  .band-bu {
    display: block;
    font-family: var(--schrift-display);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--tinte-3);
    max-width: 54ch;
  }
</style>
