---
// Kontrollierte Zeilenumbrüche: Jede Zeile wird als eigene Zeile gesetzt und
// einzeln aus einer Maske gefahren. Kein automatischer Umbruch in Titeln.
interface Props {
  zeilen: string[];
  stufe?: 'h1' | 'h2' | 'h3';
  groesse?: 'd1' | 'd2' | 'd3' | 'd4';
  klasse?: string;
  id?: string;
}
const { zeilen, stufe = 'h2', groesse = 'd2', klasse = '', id } = Astro.props;
const Tag = stufe;
---
<Tag class:list={[groesse, 'titel', klasse]} id={id} data-zeilen>
  {zeilen.map((z, i) => (
    <span class="zeile" style={`--verzug:${i * 80}ms`}><span set:html={z} /></span>
  ))}
</Tag>

<style>
  .titel { max-width: 22ch; }
  .titel :global(em) {
    font-family: var(--schrift-text);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.005em;
  }
</style>
