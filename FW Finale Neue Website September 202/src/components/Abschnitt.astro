---
// Abschnitt mit Marginalspalte: links Nummer und Kurzlabel, rechts der Inhalt.
interface Props {
  nummer?: string;
  marke?: string;
  ton?: 'papier' | 'sand' | 'dunkel';
  hoehe?: 'eng' | 'normal' | 'weit';
  id?: string;
  klasse?: string;
}
const { nummer, marke, ton = 'papier', hoehe = 'normal', id, klasse = '' } = Astro.props;
const flaeche = hoehe === 'eng' ? 'flaeche-eng' : hoehe === 'weit' ? 'flaeche-weit' : 'flaeche';
---
<section
  id={id}
  class:list={['abschnitt', flaeche, ton !== 'papier' && ton, klasse]}
>
  <div class="huelle">
    <div class="rail">
      <p class="marke">
        {nummer && <span class="marke-nr ziffer">{nummer}</span>}
        {marke && <span class="marke-text">{marke}</span>}
      </p>
      <div class="rail-inhalt"><slot /></div>
    </div>
  </div>
</section>

<style>
  .marke-nr { display: inline; }
  .marke-text { display: inline; }
  @media (min-width: 60rem) {
    .marke-nr { display: block; margin-bottom: 0.5em; }
    .marke-text { display: block; max-width: 11ch; line-height: 1.5; }
  }
</style>
