---
interface Props { groesse?: number; richtung?: 'rechts' | 'oben-rechts' }
const { groesse = 14, richtung = 'rechts' } = Astro.props;
const d = richtung === 'rechts'
  ? 'M1 7h12M8 2l5 5-5 5'
  : 'M2 12L12 2M4 2h8v8';
---
<svg class="pfeil" width={groesse} height={groesse} viewBox="0 0 14 14" fill="none"
     stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true">
  <path d={d} />
</svg>
