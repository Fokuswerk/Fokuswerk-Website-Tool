{
  "name": "serienkueche",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "planertest": "esbuild werkzeuge/planertest.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/planertest.mjs --log-level=error && node node_modules/.tmp/planertest.mjs",
    "datentest": "esbuild werkzeuge/datentest.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/datentest.mjs --log-level=error && node node_modules/.tmp/datentest.mjs",
    "umstellungtest": "esbuild werkzeuge/umstellungtest.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/umstellungtest.mjs --log-level=error && node node_modules/.tmp/umstellungtest.mjs",
    "zeitmessung": "esbuild werkzeuge/zeitmessung.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/zeitmessung.mjs --log-level=error && node node_modules/.tmp/zeitmessung.mjs",
    "test": "npm run planertest && npm run datentest && npm run umstellungtest",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.182.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.182.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
